{
  "name": "mannuel-ferreira",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "start:dev": "concurrently \"npm run watch:css\" \"npm run dev\" \"npm run typecheck -w\"",
    "build": "./install-deps.sh && pnpm exec playwright install chromium && next build --webpack",
    "build:css": "tailwindcss --minify -i styles/global.css -o public/css/tailwind.min.css",
    "watch:css": "tailwindcss --minify -i styles/global.css -o public/css/tailwind.min.css --watch",
    "lint": "next lint",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mdx,css,scss,yaml,yml}\"",
    "prettier:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,mdx,css,scss,yaml,yml}\"",
    "postinstall": "npx puppeteer browsers install chrome@135.0.7049.96",
    "format": "pnpm prettier:fix && pnpm lint --fix",
    "start": "next start",
    "typecheck": "tsc",
    "generate-sitemap": "node scripts/sitemap-generator.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-slot": "1.2.4",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-query-devtools": "5.91.3",
    "class-variance-authority": "0.7.1",
    "client-only": "0.0.1",
    "clsx": "2.1.1",
    "github-slugger": "2.0.0",
    "globby": "16.1.1",
    "lastfm-nodejs-client": "1.5.4",
    "logrocket": "12.1.0",
    "lucide-react": "0.577.0",
    "mermaid": "11.13.0",
    "next": "16.1.7",
    "next-themes": "0.4.6",
    "playwright": "1.58.2",
    "puppeteer": "24.39.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-highlight": "7.0.2",
    "rehype-mermaid": "3.0.0",
    "shiki": "4.0.2",
    "tailwind-merge": "3.5.0",
    "tailwindcss-animate": "1.0.7",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/typography": "0.5.19",
    "@types/gtag.js": "0.0.20",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "@typescript-eslint/parser": "8.57.1",
    "autoprefixer": "10.4.27",
    "eslint": "9.39.4",
    "eslint-config-next": "16.1.7",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "postcss": "8.5.8",
    "rehype-autolink-headings": "7.1.0",
    "rehype-pretty-code": "0.14.3",
    "rehype-slug": "6.0.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "velite": "0.3.1"
  }
}
