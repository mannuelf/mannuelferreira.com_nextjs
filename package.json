{
  "name": "mannuel-ferreira",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "start:dev": "concurrently \"npm run watch:css\" \"npm run dev\" \"npm run typecheck -w\"",
    "build": "./install-deps.sh && pnpm exec playwright install chromium && next build --webpack",
    "build:css": "tailwindcss --minify -i styles/global.css -o public/css/tailwind.min.css",
    "watch:css": "tailwindcss --minify -i styles/global.css -o public/css/tailwind.min.css --watch",
    "lint": "next lint",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mdx,css,scss,yaml,yml}\"",
    "prettier:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,mdx,css,scss,yaml,yml}\"",
    "postinstall": "npx puppeteer browsers install chrome@135.0.7049.96",
    "format": "pnpm prettier:fix && pnpm lint --fix",
    "start": "next start",
    "typecheck": "tsc",
    "generate-sitemap": "node scripts/sitemap-generator.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "globby": "^16.0.0",
    "lastfm-nodejs-client": "^1.5.2",
    "logrocket": "^10.1.1",
    "lucide-react": "^0.556.0",
    "mermaid": "^11.12.2",
    "next": "^16.0.7",
    "next-themes": "^0.4.6",
    "playwright": "^1.57.0",
    "puppeteer": "^24.32.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rehype-highlight": "^7.0.2",
    "rehype-mermaid": "^3.0.0",
    "shiki": "^3.19.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@types/gtag.js": "^0.0.20",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "postcss": "^8.5.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "velite": "0.3.0"
  }
}
