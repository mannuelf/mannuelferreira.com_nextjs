{
  "name": "mannuel-ferreira",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "start:dev": "concurrently \"npm run watch:css\" \"npm run dev\" \"npm run typecheck -w\"",
    "build": "./install-deps.sh && pnpm exec playwright install chromium && next build --webpack",
    "build:css": "tailwindcss --minify -i styles/global.css -o public/css/tailwind.min.css",
    "watch:css": "tailwindcss --minify -i styles/global.css -o public/css/tailwind.min.css --watch",
    "lint": "next lint",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mdx,css,scss,yaml,yml}\"",
    "prettier:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,mdx,css,scss,yaml,yml}\"",
    "postinstall": "npx puppeteer browsers install chrome@135.0.7049.96",
    "format": "pnpm prettier:fix && pnpm lint --fix",
    "start": "next start",
    "typecheck": "tsc",
    "generate-sitemap": "node scripts/sitemap-generator.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "class-variance-authority": "0.7.1",
    "client-only": "0.0.1",
    "clsx": "2.1.1",
    "framer-motion": "13.1.0",
    "github-slugger": "2.0.0",
    "globby": "16.2.3",
    "lastfm-nodejs-client": "file:../lastfm-nodejs-client",
    "logrocket": "12.1.1",
    "lucide-react": "1.31.0",
    "mermaid": "11.16.1",
    "next": "16.3.1",
    "next-themes": "0.4.6",
    "playwright": "1.62.1",
    "puppeteer": "25.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-highlight": "7.0.2",
    "rehype-mermaid": "3.0.0",
    "shiki": "4.4.3",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/gtag.js": "0.0.20",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "autoprefixer": "10.5.4",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "postcss": "8.5.26",
    "rehype-autolink-headings": "7.1.0",
    "rehype-pretty-code": "0.14.5",
    "rehype-slug": "6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "velite": "0.4.0"
  },
  "overrides": {
    "mermaid": "^11.16.1",
    "dompurify": "^3.4.13",
    "uuid": "^14.0.1",
    "lodash-es": "^4.18.1",
    "brace-expansion": "^5.0.9",
